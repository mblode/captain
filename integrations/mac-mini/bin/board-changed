#!/usr/bin/env bash
# Hermes cron pre-check for the board routine. Prints {"wakeAgent": false}
# when nothing on the Captain board moved since the last run, so an idle board
# costs no tokens. When a row changed group, next step, PR or checks, it wakes
# the bot with the rows that need a move (captain), a person (needs-you) or a
# merge (ready).
#
# A failing `captain status` exits non-zero, which Hermes delivers as an alert:
# cmux down or a broken project should reach you, not be skipped silently.
set -euo pipefail

state_dir="${CAPTAIN_BOT_STATE:-$HOME/.local/state/captain-bot}"
mkdir -p "$state_dir"
last="$state_dir/board.sig"

board="$(captain status --json)"
sig="$(printf '%s' "$board" | jq -c '[.rows[] | {id, group, next, pr: .pr.url, prState: .pr.state, checks: .pr.checks, gate: (.gate != null)}] | sort_by(.id)' | openssl dgst -sha256 -r | cut -d' ' -f1)"

if [[ -f "$last" && "$(cat "$last")" == "$sig" ]]; then
  echo '{"wakeAgent": false}'
  exit 0
fi
printf '%s' "$sig" >"$last"

# Wake only when something is actionable: a changed board whose rows all sit in
# working, queued or blocked needs nobody.
printf '%s' "$board" | jq -c '
  [.rows[] | select(.group == "captain" or .group == "needs-you" or .group == "ready" or .group == "merged")
    | {id, title, group, why, next, pr: .pr.url}] as $act
  | if ($act | length) == 0 then {wakeAgent: false}
    else {wakeAgent: true, context: {project: .project, wip: "\(.inProgress)/\(.wip)", rows: $act}}
    end'

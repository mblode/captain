<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Claude Code Remote Control in server mode: start new sessions on this Mac
     from the Claude app, one session per request, started in __CODE_DIR__
     (worktree mode needs the folder itself to be a git repository).
     launchd starts with a minimal PATH, so setup.sh bakes in the absolute
     claude path and the PATH it ran with (minus cmux's per-session shims). It fills the placeholders and loads it into the GUI domain. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>co.blode.claude-remote-control</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CLAUDE__</string>
    <string>remote-control</string>
    <string>--spawn</string>
    <string>session</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__CODE_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/claude-remote-control.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/claude-remote-control.log</string>
</dict>
</plist>
